# Local builds, toolchain and private/durable application data.
/target/
/.tools/
/var/
/dist/
/.codex/
/.agents/
/.aws/
/.ssh/

# Credentials and local environment; sample configuration may be shared.
.env
.env.*
!.env.example
!.env.template
*.key
*.p12
*.pfx
*.pem
*.p8
.netrc
.pypirc

# Generated app packages, including copies outside dist/.
*.app/
*.dSYM/
*.dmg
*.pkg

# Camera originals stay local; only the generated decoder fixtures are source.
*.[nN][eE][fF]
*.[aA][rR][wW]
*.[cC][rR]2
*.[cC][rR]3
*.[rR][aA][fF]
*.[rR][wW]2
*.[dD][nN][gG]
!/crates/tr-worker/tests/fixtures/*.dng

# Local databases, raw diagnostics and editor/runtime leftovers.
.DS_Store
*.sqlite*
*.db
*.db-shm
*.db-wal
*.log
/reports/bundle-stack.txt
*.bak
*.orig
# Cargo's vendored package metadata is source, not an editor backup.
!**/Cargo.toml.orig
*.swp
*~
__pycache__/
*.py[cod]

.truerenderer-cache/
cache-folders.json
