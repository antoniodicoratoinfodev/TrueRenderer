  "fixed_findings": [
    {
      "priority": "P1",
      "issue": "201st consecutive undo publishes an unreadable history head",
      "fix": "Reject undo at 200 before the update; can_undo reflects quota; reopening and redo remain usable",
      "test": "undo_limit_never_publishes_an_unreadable_edit_head",
      "reproduced_with_failing_test_before_fix": true
    },
    {
      "priority": "P1",
      "issue": "Single edited-view cache prevents both A/B photographs from converging",
      "fix": "Keep at most two independent results with per-photo errors, LRU eviction and existing memory leases",
      "test": "comparison_keeps_both_edited_previews_ready",
      "reproduced_with_failing_test_before_fix": true
    },
    {
      "priority": "P2",
      "issue": "Viewer fallback can use a different RAW engine from the requested or stored recipe",
      "fix": "Require matching RAW engine for fallback candidates",
      "test": "viewer_fallback_never_uses_another_raw_engine",
      "evidence": "Code inspection and regression on corrected implementation"
    },
    {
      "priority": "P2",
      "issue": "Edited opaque images are incorrectly tagged translucent and use different reduction filters",
      "fix": "Preserve source opacity in edited viewer and thumbnail pyramids",
      "test": "edited_preview_and_thumbnail_keep_reference_filters",
      "evidence": "Code inspection and pixel-exact comparison of every mip for opaque and varying-alpha synthetic images"
    },
    {
      "priority": "P2",
      "issue": "In-flight quick preview can satisfy a later native-verification request indefinitely",
      "fix": "Require matching base level as well as source and recipe for cached images and failures",
      "test": "edited_preview_marks_reduced_work_and_can_converge_from_native_source",
      "reproduced_with_failing_test_before_fix": true
    }
  ],
